{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "regions": ["fra1"],
  "functions": {
    "app/api/search/route.ts": {
      "maxDuration": 60
    },
    "app/api/query-form/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/query-form/export/route.ts": {
      "maxDuration": 30
    }
  }
}
