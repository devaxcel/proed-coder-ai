# ==========================================================================
# ProEd Coder AI — Environment Variables
# ==========================================================================
# Copy this file to .env for local dev, or set these in Vercel/Railway dashboard.
# Never commit .env to git.
# ==========================================================================


# === Database (Postgres with pgvector) ===
# Neon (recommended): https://neon.tech — free tier: 0.5 GB, Launch tier: $19/mo for 10 GB
# Railway Postgres (alternative): $5/mo hobby tier
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"


# === Auth (NextAuth v5) ===
# Generate AUTH_SECRET with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
AUTH_SECRET="paste-a-32-byte-random-secret-here"

# Team password — everyone shares this until Phase 5.2 (email magic link)
# Pick something strong. Rotate if compromised.
APP_PASSWORD="pick-a-strong-team-password-here"

# === Two-factor sign-in (authenticator app) ===
# Generate the key ONCE with:  openssl rand -hex 32     (keep it secret; never change it
# afterwards or existing authenticators stop working)
# MFA_ENCRYPTION_KEY="64-hex-characters-here"
# Set to "on" ONLY after MFA_ENCRYPTION_KEY is set and the database migration has run.
# Every user is then asked to set up an authenticator at their next sign-in.
# MFA_ENFORCEMENT="on"
# Minutes of inactivity before automatic logoff (default 30, minimum 5)
# NEXT_PUBLIC_IDLE_TIMEOUT_MIN=30

# Auth trust proxy setting — required on Vercel / Railway / any hosted platform
AUTH_TRUST_HOST=true

# AUTH_URL is only needed if you're using a custom domain in production
# Vercel sets it automatically. Uncomment and set for custom domains:
# AUTH_URL="https://coder.axcelworld.com"


# === LLM (Groq — free tier) ===
# Sign up: https://console.groq.com — free tier is generous
GROQ_API_KEY="gsk_..."
LLM_PROVIDER="groq"   # or "anthropic"

# Anthropic alternative (if you want to swap)
# ANTHROPIC_API_KEY="sk-ant-..."


# === Embeddings ===
# For LOCAL DEV: use "xenova" — runs locally, no API needed, free
# For VERCEL PROD: use "voyage" or "openai" — Xenova has ~30s cold start on serverless
# For RAILWAY PROD: "xenova" works fine (persistent process, no cold starts)
EMBEDDING_PROVIDER="xenova"

# Voyage AI (recommended for Vercel prod, 10M tokens/mo free tier)
# Sign up: https://www.voyageai.com
# VOYAGE_API_KEY="pa-..."

# OpenAI (alternative)
# OPENAI_API_KEY="sk-..."


# === Optional Observability ===
# NEXT_PUBLIC_APP_ENV="production"    # or "staging", "development"
